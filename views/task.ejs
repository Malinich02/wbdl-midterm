<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TASK MANAGEMENT SYSTEM - LIST TASKS</title>
    <!-- Link style table.css -->
    <link rel="stylesheet" href="/css/table.css" />
  </head>
  <body>
    <div class="table-container">
      <h1>TASK MANAGEMENT SYSTEM</h1>
      <a href="/" class="add-btn">+ CREATE TASK</a>

      <!-- Table to display tasks -->
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>TASK TITLE</th>
            <th>DESCRIPTION</th>
            <th>STATUS</th>
            <th>ACTIONS</th>
          </tr>
        </thead>
        <tbody>
          <% const tasks = (typeof listtask !== 'undefined' && listtask) ? listtask : ((typeof listproduct !== 'undefined' && listproduct) ? listproduct : []); %>
          <% if (tasks && tasks.length > 0) { %>
            <% tasks.forEach(task => { %>
              <% 
                const rawStatus = task.status || 'Pending';
                const statusSlug = rawStatus.toLowerCase().replace(/\s+/g, '-');
              %>
              <tr>
                <td><%= task._id %></td>
                <td class="task-title-cell"><%= task.task_title || task.productname %></td>
                <td class="task-desc-cell"><%= task.description || 'No description' %></td>
                <td>
                  <span class="status-badge status-<%= statusSlug %>">
                    <%= rawStatus %>
                  </span>
                </td>
                <td class="action">
                  <a href="/update/<%= task._id %>" class="btn-edit">Edit</a>
                  <a href="/delete/<%= task._id %>" class="btn-delete">Delete</a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 30px; color: #888;">No tasks found. Click "+ CREATE TASK" to add one!</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </body>
</html>

